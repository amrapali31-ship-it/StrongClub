# Passcode for the /admin area. Change this before you share the link.
ADMIN_PASSCODE=letmein

# Leave both blank to use the local JSON store in .data/db.json.
# Fill them in to use a real database, then run: npm run check:supabase
#
# URL: the bare project origin, with no path on the end. supabase-js adds
#      /rest/v1 itself, so https://xxxx.supabase.co/rest/v1/ will not work.
# KEY: the service_role key, not anon — anon is blocked by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Powers "Import with AI" in the admin area. Leave blank to hide that feature.
# Get one at console.anthropic.com — this is an API key, separate from any
# Claude subscription you pay for.
ANTHROPIC_API_KEY=
